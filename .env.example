# Set to true only to use placeholder answers without a backend.
NEXT_PUBLIC_USE_DEMO=false

# By default, the browser calls the same-origin /api/chat route so CORS is avoided.
# Use the direct-API option only if your upstream RAG service explicitly supports
# browser CORS and you need to bypass the proxy.
# NEXT_PUBLIC_ALLOW_DIRECT_CHAT_API=false
# NEXT_PUBLIC_API_URL=https://your-rag-api.example.com
# The Next.js server proxies chat requests to this backend.
RAG_API_BASE_URL=http://localhost:8000

# SEC requests are made server-side; replace with your app name and a monitored email.
SEC_USER_AGENT=LedgerMind contact: your-email@example.com
